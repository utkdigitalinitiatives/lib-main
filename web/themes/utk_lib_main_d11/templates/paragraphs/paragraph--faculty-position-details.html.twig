{#
/**
 * @file
 * Position details for a faculty posting.
 */
#}

<div{{ attributes.addClass('row', 'g-4') }}>
    {% if not paragraph.field_faculty_category.isEmpty %}
        {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
            label: 'Position Type',
            value: content.field_faculty_category|render|striptags|trim,
        }, with_context: false) }}
    {% endif %}

    {% if not paragraph.field_appointment_rank.isEmpty %}
        {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
            label: 'Rank',
            value: content.field_appointment_rank,
        }, with_context: false) }}
    {% endif %}

    {% if not paragraph.field_salary_details.isEmpty %}
        {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
            label: 'Salary',
            value: content.field_salary_details,
        }, with_context: false) }}
    {% endif %}

    {% if not paragraph.field_available.isEmpty %}
        {% set available_date %}
            <time datetime="{{ paragraph.field_available.value }}">
                {{ paragraph.field_available.value|date('j F, Y') }}
            </time>
        {% endset %}
        {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
            label: 'Available',
            value: available_date,
        }, with_context: false) }}
    {% endif %}
</div>
