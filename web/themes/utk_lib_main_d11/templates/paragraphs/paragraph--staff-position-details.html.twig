{#
/**
 * @file
 * Position details for a staff posting.
 */
#}

<div{{ attributes.addClass('row', 'g-4') }}>
    {% if not paragraph.field_staff_category.isEmpty %}
        {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
            label: 'Position Type',
            value: content.field_staff_category|render|striptags|trim,
        }, with_context: false) }}
    {% endif %}

    {% if not paragraph.field_salary_details.isEmpty %}
        {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
            label: 'Salary',
            value: content.field_salary_details,
        }, with_context: false) }}
    {% endif %}
</div>
