{%
    set classes = [
        'container',
        'text-smokey',
        'utk-article--section-label',
        'px-0',
        'py-3'
    ]
%}

{% set heading_text = paragraph.field_heading_text.value|default('') %}

{% if heading_text %}
    <h2 {{ attributes.addClass(classes) }} id="{{ heading_anchor }}">
        {{ heading_text }}
    </h2>
{% endif %}
