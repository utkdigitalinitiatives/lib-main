{#
/**
 * @file
 * UTK Custom - News section image Paragraph template.
 *
 * This template centers a full-width News image and renders its caption.
 *
 * @see paragraph.html.twig
 */
#}

{% set image_media = paragraph.field_image.entity|default(null) %}
{% set image_alt = (paragraph.field_decorative.value != '1' and image_media and image_media.field_media_image is defined)
  ? image_media.field_media_image.alt|default('')
  : ''
%}

<div class='d-flex justify-content-center'>
  <figure class='figure utk-article--image mx-auto'>
      <img class='img-fluid rounded' src="{{ paragraph.field_image|file_url }}" alt="{{ image_alt }}" loading="lazy">
      <figcaption class='figure-caption'>
          {{ paragraph.field_image_caption.value }}
      </figcaption>
  </figure>
</div>
