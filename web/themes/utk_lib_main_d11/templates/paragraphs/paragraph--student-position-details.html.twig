{#
/**
 * @file
 * Position details for a student posting.
 */
#}

<div{{ attributes.addClass('row', 'g-4') }}>
    {% if not paragraph.field_student_job_category.isEmpty %}
        {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
            label: 'Position Type',
            value: content.field_student_job_category|render|striptags|trim,
        }, with_context: false) }}
    {% endif %}

    {% if not paragraph.field_hours_per_week.isEmpty %}
        {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
            label: 'Hours Per Week',
            value: content.field_hours_per_week,
        }, with_context: false) }}
    {% endif %}

    {% if not paragraph.field_salary_details.isEmpty %}
        {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
            label: 'Pay Rate',
            value: content.field_salary_details,
        }, with_context: false) }}
    {% endif %}
</div>
