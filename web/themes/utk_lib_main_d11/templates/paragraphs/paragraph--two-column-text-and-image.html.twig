{#
/**
 * @file
 * UTK Custom - Two Column Text and Image Paragraph template.
 *
 * Places the text and image in two responsive columns, with their order
 * controlled by the field_text_on_right field.
 *
 * @see paragraph.html.twig
 */
#}

{% set text_on_right = paragraph.field_text_on_right.value == '1' %}
{% set image_media = paragraph.field_image.entity|default(null) %}
{% set image_alt = paragraph.field_decorative.value == '1'
  ? ''
  : (image_media and image_media.field_media_image is defined ? image_media.field_media_image.alt|default('') : '')
%}

{% if not paragraph.field_text.isEmpty or not paragraph.field_image.isEmpty %}
  <div class="row py-1">
    {% if not text_on_right and not paragraph.field_text.isEmpty %}
      <div class="col-lg-6">
        {{ content.field_text }}
      </div>
    {% endif %}

    {% if not paragraph.field_image.isEmpty and image_media %}
      <figure class="figure col-lg-6">
        <img class="img-fluid utk-in-section--image rounded"
             src="{{ paragraph.field_image|file_url }}"
             alt="{{ image_alt }}"
             loading="lazy">
        {% if not paragraph.field_image_caption.isEmpty %}
          <figcaption class="figure-caption utk-figure-caption">
            {{ content.field_image_caption }}
          </figcaption>
        {% endif %}
      </figure>
    {% endif %}

    {% if text_on_right and not paragraph.field_text.isEmpty %}
      <div class="col-lg-6">
        {{ content.field_text }}
      </div>
    {% endif %}
  </div>
{% endif %}
