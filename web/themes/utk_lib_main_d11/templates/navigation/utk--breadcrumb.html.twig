{#
/**
 * @file
 * UTK Custom - Breadcrumb template.
 *
 * This template is used to render the breadcrumb navigation with custom styling and layout.
 *
 * Available variables:
 * - content_path: The current path of the page.
 * - split_path: An array of the segments of the current path.
 * - category_label: The label of the category associated with the page (if applicable).
 * - category_url: The URL-friendly version of the category label.
 * - final_string: The final breadcrumb label for the current page.
 * - content_url: The base URL for the breadcrumb link.
 * - content_url_name: The name of the base URL for display in the breadcrumb.
 *
 * Customizations:
 * - Dynamically generates breadcrumb links based on the current path.
 * - Includes category-specific links for service and about pages.
 * - Capitalizes breadcrumb labels for better readability.
 * - Ensures responsive design for both desktop and mobile layouts.
 *
 * @see template_preprocess_breadcrumb()
 */
#}

{% set content_path = path('<current>') %}
{% set split_path = content_path|split('/') %}

{% if content.field_service_page_details['#items'].0.entity %}
    {% set paragraph = content.field_service_page_details['#items'].0.entity %}
    {% set category_label = paragraph.field_service_category.entity.label %}
    {% set category_url = category_label|lower|split(' ')|join('-') %}
{% endif %}

{% if content.field_about_page_details['#items'].0.entity %}
    {% set paragraph = content.field_about_page_details["#items"].0.entity %}
    {% set category_label = paragraph.field_about_category.entity.label %}
    {% set category_url = category_label|lower|split(' ')|join('-') %}
{% endif %}

{% if split_path|length > 2 %}
    {% set endpoint_arr = split_path[2]|split('-') %}
    {% set capitalized_words = [] %}

    {% for word in endpoint_arr %}
        {% if word != "and" %}
            {% set capitalized_word = word|capitalize %}
            {% set capitalized_words = capitalized_words|merge([capitalized_word]) %}
        {% endif %}
        {% if word == "and" %}
             {% set capitalized_words = capitalized_words|merge([word]) %}
        {% endif %}
        
    {% endfor %}

    {% if node.title.0.value %}
        {% set final_string = node.title.0.value %}
    {% else %}
        {% set final_string = capitalized_words|join(' ') %}
    {% endif %}
{% endif %}

{% if node.bundle == "news" %}
    {% set content_url = "news" %}
    {% set content_url_name = "news" %}
{% elseif split_path[1] == "department" or split_path[1] == "employee" or split_path[1] == "contact" %}
    {% set content_url = "directory" %}
    {% set content_url_name = "directory" %}
{% else %}
    {% set content_url = split_path[1] %}    
    {% set content_url_name = split_path[1] %}
{% endif %} 

<nav class="breadcrumb-wrapper text-white" role="navigation" aria-labelledby="system-breadcrumb" aria-label='breadcrumb'>
    <div class="breadcrumb-bg px-3 py-1 d-inline-block">
        <ol class="breadcrumb m-0">
            {% set is_home = split_path|length <= 1 %}
        
            <li class="breadcrumb-item link-white font-small breadcrumb-search-selector {% if is_home %}active{% endif %}">
                {% if is_home %}
                    <a href="{{ path('<front>') }}" aria-current="page">Home</a>
                {% else %}
                    <a href="{{ path('<front>') }}">Home</a>
                {% endif %}
            </li>
            {% set is_section = split_path|length == 2 %}
        
            {% if content_url_name %}
                <li class="breadcrumb-item link-white font-small breadcrumb-search-selector {% if is_section %}active{% endif %}">
                    {% if is_section %}
                        <a href="/{{ content_url }}" aria-current="page">{{ content_url_name|capitalize }}</a>
                    {% else %}
                        <a href="/{{ content_url }}">{{ content_url_name|capitalize }}</a>
                    {% endif %}
                </li>
            {% endif %}
            {% set is_category = split_path|length == 3 and category_label %}
        
            {% if category_label %}
                <li class="breadcrumb-item link-white font-small breadcrumb-search-selector {% if is_category %}active{% endif %}">
                    {% if is_category %}
                        <a href="/{{ content_url }}/{{ category_url }}" aria-current="page">{{ category_label }}</a>
                    {% else %}
                        <a href="/{{ content_url }}/{{ category_url }}">{{ category_label }}</a>
                    {% endif %}
                </li>
            {% endif %}
            {% if split_path|length > 2 and not is_category %}
                <li class="breadcrumb-item link-white font-small breadcrumb-search-selector active" aria-current="page">{{ final_string }}</li>
            {% endif %}
        </ol>
    </div>
</nav>
