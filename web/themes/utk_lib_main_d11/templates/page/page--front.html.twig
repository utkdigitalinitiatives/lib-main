{#
/**
 * @file
 * Theme override for the front page layout.
 *
 * This template provides the structure for the front page of the site.
 *
 * Available variables:
 * - attributes: HTML attributes for the main container.
 * - page: Contains the content of the page, including regions such as header, footer, and main content.
 * - content: Rendered content of the page.
 *
 * Included templates:
 * - utk--header.html.twig: Renders the site header.
 * - utk--search-section.html.twig: Displays the search section on the front page.
 * - utk--icon-section.html.twig: Displays the icon section on the front page.
 * - utk--quicklink-section.html.twig: Displays quick links for navigation.
 * - utk--library-footer.html.twig: Renders the library footer.
 * - utk--campus-footer.html.twig: Renders the campus footer.
 * - utk--campus-footer-subfooter.html.twig: Renders the subfooter for the campus footer.
 *
 * Dynamic content:
 * - drupal_block('views_block:library_hours-hours_block'): Displays the library hours block.
 * - drupal_view('spotlight_collection', 'spotlight_block'): Displays the spotlight collection block.
 * - drupal_view('news_view', 'news_block'): Displays the recent news block.
 * - drupal_view('events_view', 'events_block'): Displays the upcoming events block.
 *
 * @see page.html.twig
 * @see node_preprocess_page()
 */
#}


<hr class="top-line py-0">
<div class="layout-container">
    <header class="header">
        {% include "/themes/utk_lib_main_d11/templates/layout/utk--header.html.twig" %}
    </header>

    <main role="main" id="main-content">
        <div class='position-relative'>
            <div class='utk-header-overlay w-100 h-100 position-absolute top-0 start-0 object-fit-cover z-1'></div>
            <img src="/themes/utk_lib_main_d11/images/front-bright.webp" srcset="/themes/utk_lib_main_d11/images/front-bright-small.webp 640w,
                                                                            /themes/utk_lib_main_d11/images/front-bright-medium.webp 1200w,
                                                                            /themes/utk_lib_main_d11/images/front-bright.webp 1920w" sizes="100vw" alt="University of Tennessee Libraries background" class="w-100 h-100 position-absolute top-0 start-0 object-fit-cover z-n2" loading="eager" fetchpriority="high">
            <section class='container-fluid d-flex align-items-end utk--search-section position-relative py-4 utk--1400px-width z-2'>
                {% include "/themes/utk_lib_main_d11/templates/layout/utk-front-page/utk--search-section.html.twig" %}
            </section>
        </div>

        <div class="utk-icon--svg">
            <section class='container-fluid position-relative py-4 z-2 utk-icon-section-overlay'>
                {% include "/themes/utk_lib_main_d11/templates/layout/utk-front-page/utk--icon-section.html.twig" %}
            </section>

            <div class="utk-homepage-subtle-overlay">
                <section class='container-fluid  py-5 my-4'>
                {# TODO: uncomment once the view has been added #}
                    {# {{ drupal_block('views_block:homepage_hours-hours_block', wrapper=false)}} #}
                </section>

                <section class='container-fluid pb-5 my-5'>
                    {% include "/themes/utk_lib_main_d11/templates/layout/utk-front-page/utk--quicklink-section.html.twig" %}
                </section>
            </div>
        </div>

        <section class='container-fluid utk--inset-box-shadow py-5 my-5 utk-spotlight-section'>
            <div class='row justify-content-center align-items-center'>
                <h2 class="utk-spotlight-title text-smokey mb-5">
                    SPOTLIGHT
                    {# Commenting out instead of deleting for now #}
                    {# <span class="utk-spotlight-flashlight ms-2" aria-hidden="true">🔦</span> #}
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16.75 1.25a.75.75 0 0 1 .75.75v1A.75.75 0 0 1 16 3V2a.75.75 0 0 1 .75-.75Zm3.72 1.22a.75.75 0 1 1 1.06 1.06l-2 2a.75.75 0 1 1-1.06-1.06l2-2ZM8.25 6.31v2.88l6.56 6.56h2.88L8.25 6.31ZM19.06 15l1.41-1.409a2.25 2.25 0 0 0 0-3.182L13.59 3.53a2.25 2.25 0 0 0-3.182 0L9 4.94 19.06 15ZM13 16.06 7.94 11l-4.91 4.909a2.25 2.25 0 0 0 0 3.182L4.91 20.97a2.25 2.25 0 0 0 3.182 0L13 16.06Zm-3.47-1.59a.75.75 0 0 1 0 1.06l-1.5 1.5a.75.75 0 1 1-1.06-1.06l1.5-1.5a.75.75 0 0 1 1.06 0ZM22 8h-1a.75.75 0 0 1 0-1.5h1A.75.75 0 0 1 22 8Z" fill="#4b4b4b"/>
                    </svg>
                </h2>
            </div>
            {# TODO: uncomment once the view has been added #}
            {# {{ drupal_view('spotlight_collection', 'spotlight_block') }} #}
        </section>

        <div class="utk-icon--svg">
            <div class="utk-homepage-subtle-overlay">
                <section class='container-fluid py-5 my-5'>
                    <div class='utk-homepage-news-events-grid mx-auto max-row-width'>
                        <div class='utk-homepage-news-events-grid__item'>
                            <div class='utk-card'>
                                <div class='utk-card-header utk-card-header--small-section'>
                                    <h3>Recent News</h3>
                                </div>
                                <div class='utk-card-body utk-news-events-block'>
                                    {{ drupal_view('news_view', 'news_block') }}
                                    <div class='d-flex align-items-end link-link utk-search-selector'>
                                        <a href='/news' class='ms-auto mt-auto mb-0 pt-2'>More News
                                            <svg width="24" height="24" fill="none" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label='arrow-icon'>
                                                <path d="M13.267 4.209a.75.75 0 0 0-1.034 1.086l6.251 5.955H3.75a.75.75 0 0 0 0 1.5h14.734l-6.251 5.954a.75.75 0 0 0 1.034 1.087l7.42-7.067a.996.996 0 0 0 .3-.58.758.758 0 0 0-.001-.29.995.995 0 0 0-.3-.578l-7.419-7.067Z" fill="#ff8200"/>
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class='utk-homepage-news-events-grid__item'>
                            <div class='utk-card'>
                                <div class='utk-card-header utk-card-header--small-section'>
                                    <h3>Upcoming Events</h3>
                                </div>
                                <div class='utk-card-body utk-news-events-block'>
                                {# TODO: uncomment once the view has been added #}
                                    {# {{ drupal_view('events_view', 'events_block') }} #}
                                    <div class='d-flex align-items-end link-link utk-search-selector'>
                                        <a href='https://calendar.utk.edu/department/libraries' class='ms-auto mt-auto mb-0 pt-2'>More Events
                                            <svg width="24" height="24" fill="none" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13.267 4.209a.75.75 0 0 0-1.034 1.086l6.251 5.955H3.75a.75.75 0 0 0 0 1.5h14.734l-6.251 5.954a.75.75 0 0 0 1.034 1.087l7.42-7.067a.996.996 0 0 0 .3-.58.758.758 0 0 0-.001-.29.995.995 0 0 0-.3-.578l-7.419-7.067Z" fill="#ff8200"/>
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </main>
    <footer>
        <hr class="top-line py-0">
        {% include "themes/utk_lib_main_d11/templates/layout/utk--library-footer.html.twig" %}
        {% include "themes/utk_lib_main_d11/templates/layout/utk--campus-footer/utk--campus-footer.html.twig" %}
        {% include "themes/utk_lib_main_d11/templates/layout/utk--campus-footer/utk--campus-footer-subfooter.html.twig" %}
    </footer>
</div>
