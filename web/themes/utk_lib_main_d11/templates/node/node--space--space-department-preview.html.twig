{#
/**
 * @file
 * UTK Custom - Space Department Preview template.
 *
 * This template is used to render a preview of spaces associated with departments.
 * It displays a featured photo, the space name, and location details with a link to the full space page.
 *
 * Available variables:
 * - url: The URL of the node's full page.
 * - node: The node entity being rendered, including:
 *   - node.label: The title of the space.
 *   - node.field_space_featured_photo: The featured photo field for the space.
 * - content: Rendered content of the node, including:
 *   - content.field_location: The location of the space.
 *   - content.field_room_number: The room number of the space.
 *
 * Customizations:
 * - Displays a placeholder image if no featured photo is provided.
 * - Provides a structured layout with the image, title, and location details.
 * - Includes lazy loading for images to improve performance.
 *
 * @see node.html.twig
 * @see node_preprocess_node()
 */
#}

{% set location = node.field_location.entity.label|default('')|trim %}
{% set room_number = node.field_room_number.value|default('')|trim %}
{% set location_label = location ~ (room_number ? ' - ' ~ room_number : '') %}
{% set normalized_title = node.label|lower|replace({' - ': ' ', '-': ' '}) %}
{% set normalized_location = location_label|lower|replace({' - ': ' ', '-': ' '}) %}
{% set placeholder_image = (base_path|default('/', true)) ~ directory ~ '/images/placeholder-spaces.png' %}

<a class="utk--cards mx-2" href="{{ url }}">
    {% if node.field_space_featured_photo|length > 0 %}
        <img src="{{ node.field_space_featured_photo|file_url }}" alt="" loading="lazy">
    {% else %}
        <img src="{{ placeholder_image }}" alt="" loading="lazy">
    {% endif %}
    <div class="utk--cards-text-body">
        <p class="fs-6 fw-medium">{{ node.label }}</p>
        {% if location_label and normalized_location != normalized_title %}
            <p class="flex-row">{{ location_label }}</p>
        {% endif %}
    </div>
</a>
