{#
/**
 * @file
 * UTK Custom - Department teaser template.
 *
 * Renders a department as a compact Service Contact.
 *
 * @see node.html.twig
 */
#}

<a class="utk-service-contact__link" href="{{ url }}" aria-label="Learn more about {{ node.label }}">
  <div class="row g-0 d-flex align-items-center utk-service-contact utk-contact-hover">
    <div class="col-12 px-0">
      <div class="utk-service-contact__title fw-semibold">{{ node.label }}</div>
    </div>
  </div>
</a>
