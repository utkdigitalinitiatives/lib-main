{# Custom Bookplate node page. #}
{% set classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  'container-fluid',
  'px-0',
  'text-smokey'
] %}

{% set default_cover_src = '/themes/utk_lib_main_d11/images/placeholder-bookcover.png' %}
{% set media_cover_src = node.field_book_cover|file_url %}
{% set cover_src = cover_src_from_preprocess ?: (media_cover_src ?: default_cover_src) %}
{% set cover_alt = cover_alt_from_preprocess ?: 'Book cover' %}

<article {{ attributes.addClass(classes) }} id="utk-bookplate-page">
  {% include "@utk_lib_main_d11/templates/views/utk--page-hero.html.twig" with {
    title: node.label,
    image_src: hero_image_src|default(''),
    responsive_image_base: hero_responsive_image_base|default(''),
    image_alt: hero_image_alt|default('')
  } %}

  <div class="container-fluid utk--inset-box-shadow py-4">
    <div class="row max-row-width mx-auto">
      <div class="col-lg-8 mx-auto px-3">
        <div class="bookplate-content mb-4">
          <div class="utk-card bookplate-card shadow-sm mb-4 mx-auto">
            <div class="utk-card-body p-0">
              <img src="{{ cover_src }}" alt="{{ cover_alt }}" class="img-fluid w-100 rounded-top" loading="lazy">
            </div>
          </div>

          <div class="utk-card shadow-sm">
            <div class="utk-card-header utk-card-header--small-section">
              <h2 class="fs-5 mb-0">Book Details</h2>
            </div>
            <div class="utk-card-body">
              {% if content.field_book_title %}<div class="mb-3"><strong>Title</strong>{{ content.field_book_title }}</div>{% endif %}
              {% if content.field_book_author %}<div class="mb-3"><strong>Author</strong>{{ content.field_book_author }}</div>{% endif %}
              {% if content.field_award_year %}<div class="mb-3"><strong>Award Year</strong>{{ content.field_award_year }}</div>{% endif %}
              {% if content.field_isbn.0['#context'].value|length > 0 %}<div class="mb-3"><strong>ISBN</strong>{{ content.field_isbn }}</div>{% endif %}
              {% if content.field_ebook.0['#markup'] == 'Yes' %}<div class="mb-3"><strong>Ebook</strong></div>{% endif %}
              {% if content.field_link_to_record %}<div class="mb-0">{{ content.field_link_to_record }}</div>{% endif %}
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4 py-2">
        {% if content.field_honoree_photo or node.label %}
          <div class="utk-card shadow-sm">
            <div class="utk-card-header utk-card-header--small-section">
              <h2 class="fs-5 mb-0">Honoree Information</h2>
            </div>
            <div class="utk-card-body">
              {% if content.field_honoree_photo %}<div class="mb-3">{{ content.field_honoree_photo }}</div>{% endif %}
              {% if node.label %}<p class="fw-bold mb-2">{{ node.label }}</p>{% endif %}
              {% if content.field_position_role %}<div class="mb-2"><strong>Position</strong>{{ content.field_position_role }}</div>{% endif %}
              {% if content.field_bp_department %}<div class="mb-0"><strong>Department</strong>{{ content.field_bp_department }}</div>{% endif %}
            </div>
          </div>
        {% endif %}

        {% if content.field_occasion %}
          <div class="utk-card shadow-sm">
            <div class="utk-card-header utk-card-header--small-section"><h2 class="fs-5 mb-0">Occasion</h2></div>
            <div class="utk-card-body">{{ content.field_occasion }}</div>
          </div>
        {% endif %}

        {% if content.field_why_chosen|length > 2 %}
          <div class="utk-card shadow-sm">
            <div class="utk-card-header utk-card-header--small-section"><h2 class="fs-5 mb-0">Why Chosen</h2></div>
            <div class="utk-card-body">{{ content.field_why_chosen }}</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</article>
