{#
/**
 * @file
 * UTK Custom - Space Page template.
 *
 * This template is used to render the Space content type with custom
 * styling and layout.
 *
 * Available variables:
 * - attributes: HTML attributes for the main container.
 * - node: The node entity being rendered, including:
 *   - node.label: The title of the space.
 *   - node.field_space_featured_photo: The featured photo field for the space.
 * - content: Rendered content of the node, including:
 *   - content.field_additional_space_photos: Additional photos of the space.
 *   - content.field_location: The location of the space.
 *   - content.field_floor: The floor where the space is located.
 *   - content.field_room_number: The room number of the space.
 *   - content.field_capacity: The capacity of the space.
 *   - content.field_noise_level: The noise level of the space.
 *   - content.field_space_type: The type of the space.
 *   - content.field_reservation_link: A link to reserve the space.
 *   - content.field_space_description: A description of the space.
 *   - content.field_service_catalog: A list of services associated with the space.
 *
 * Customizations:
 * - Displays a carousel for multiple photos or a single image if only one is available.
 * - Includes a placeholder image if no featured photo is provided.
 * - Dynamically displays space details such as location, floor, room number, and capacity.
 * - Provides a "Reserve Now" button if the space is reservable.
 * - Conditionally displays sections like "About this Space" and "Services" based on content availability.
 *
 * Included templates:
 * - utk--breadcrumb.html.twig: Renders the breadcrumb navigation.
 * - utk--large-button.html.twig: Renders a large button for reservation links.
 *
 * @see node.html.twig
 * @see node_preprocess_node()
 */
#}

{%
    set classes = [
        'node',
        'node--type-' ~ node.id|clean_class,
        'container-fluid',
        'mb-4',
        'pb-4',
        'px-0',
        'mx-0',
        'text-smokey',
        'link-link',
    ]
%}
{% set alt = content.field_space_photo.alt %}

<article {{ attributes.addClass(classes) }}>
    {{ include('@utk_lib_main_d11/templates/views/utk--page-hero.html.twig', {
        title: node.label,
        image_src: hero_image_src|default(''),
        responsive_image_base: hero_responsive_image_base|default(''),
        image_alt: hero_image_alt|default(''),
    }) }}
    <div class='container-fluid utk--striped-background py-4'>
        <div class='d-flex justify-content-center row utk--1400px-width mx-auto'>
            {% if content.field_additional_space_photos|length > 3 %}
            <div class="col-12 col-lg-6 utk-radius-large pt-2">
                <div id="carouselExampleIndicators" class="carousel slide utk-carousel utk--spaces-images utk-radius-large">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0"
                            class="active" aria-current="true" aria-label="Slide 1"></button>
                        {% set count = 1 %}
                        {% for item in content.field_additional_space_photos['#items'] %}
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="{{ count }}" aria-label="Slide"></button>
                        {% set count = count + 1 %}
                        {% endfor %}
                    </div>
                    <div class='carousel-inner'>
                        <div class='carousel-item active'>
                            <img src="{{ node.field_space_featured_photo|file_url }}" class='d-block w-100 mx-auto' alt="{{ content.field_space_featured_photo['#items'].entity.field_media_image.alt }}" loading="lazy">
                        </div>
                        {% for item in content.field_additional_space_photos['#items'] %}
                        <div class='carousel-item'>
                            <img src="{{ item.entity|file_url }}" class='d-block w-100 mx-auto'
                                alt="{{ content.field_additional_space_photos.0['#items'].entity.field_media_image.alt }}" loading="lazy">
                        </div>
                        {% endfor %}
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators"
                        data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators"
                        data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
            {% else %}
            <div class='col-12 col-lg-6 utk--spaces-images d-flex justify-content-center pt-2'>
                <img src="{{ node.field_space_featured_photo|file_url }}" class='img-fluid utk-radius-large'
                    alt="{{ content.field_space_featured_photo['#items'].entity.field_media_image.alt }}" loading="lazy">
            </div>
            {% endif %}
            <div class='col-12 col-lg-6 d-flex justify-content-lg-start justify-content-center text-smokey link-link pt-3 pt-lg-2'>
                <div class='font-medium'>
                    {% set reservation_status %}
                        {% if not node.field_reservation_link_url.isEmpty %}
                        <span class="badge rounded-pill utk-details-card__status utk-details-card__status--reservable">Reservable</span>
                        {% else %}
                        <span class="badge rounded-pill utk-details-card__status utk-details-card__status--not-reservable">Not Reservable</span>
                        {% endif %}
                    {% endset %}
                    {% set space_details_content %}
                            <div class="row g-4">
                                {% if not node.field_location.isEmpty %}
                                    {% set location_value %}
                                        {{ content.field_location.0['#title'] }}{% if not node.field_room_number.isEmpty %}, Room {{ content.field_room_number }}{% endif %}
                                    {% endset %}
                                    {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
                                        label: 'Location',
                                        value: location_value,
                                        icon_class: 'fluent-icon-location',
                                        column_classes: ['col-12', 'col-md-6'],
                                    }, with_context: false) }}
                                {% endif %}

                                {% if not node.field_floor.isEmpty %}
                                    {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
                                        label: 'Floor',
                                        value: content.field_floor,
                                        icon_class: 'fluent-icon-arrow-circle-right',
                                        column_classes: ['col-12', 'col-md-6'],
                                    }, with_context: false) }}
                                {% endif %}

                                {% if not node.field_capacity.isEmpty %}
                                    {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
                                        label: 'Capacity',
                                        value: content.field_capacity,
                                        icon_class: 'fluent-icon-couch',
                                        column_classes: ['col-12', 'col-md-6'],
                                    }, with_context: false) }}
                                {% endif %}

                                {% if not node.field_noise_level.isEmpty %}
                                    {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
                                        label: 'Noise Level',
                                        value: content.field_noise_level,
                                        icon_class: 'fluent-icon-headphones',
                                        column_classes: ['col-12', 'col-md-6'],
                                    }, with_context: false) }}
                                {% endif %}

                                {% if not node.field_space_type.isEmpty %}
                                    {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
                                        label: 'Space Type',
                                        value: content.field_space_type,
                                        icon_class: 'fluent-icon-building',
                                        column_classes: ['col-12', 'col-md-6'],
                                    }, with_context: false) }}
                                {% endif %}
                            </div>

                            {% if not node.field_reservation_link_url.isEmpty %}
                            <div class='d-flex justify-content-center my-3'>
                                <a class='btn utk-blue-button' href="{{ content.field_reservation_link_url[0]['#plain_text'] }}">Reserve Now</a>
                            </div>
                            {% endif %}
                    {% endset %}
                    {{ include('@utk_lib_main_d11/templates/components/utk--panel-card.html.twig', {
                        title: 'Details',
                        card_content: space_details_content,
                        header_content: reservation_status,
                        variant: 'details',
                        card_classes: ['mb-4'],
                    }, with_context: false) }}

                    {% if not node.field_space_description.isEmpty %}
                    <div class="mb-4 utk-search-selector link-link underline-active">
                        <h2 class="fs-3 utk-section-heading">About this Space</h2>
                        {{ content.field_space_description }}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    {% if not node.field_service_catalog.isEmpty %}
    <div class='container-fluid py-3 utk--striped-background text-smokey utk--inset-box-shadow'>
        <div class="utk--1400px-width mx-auto">
            <h2 class='fs-3 utk-section-heading'>
                Services
            </h2>
            <div class='row d-flex justify-content-center mx-lg-5 mx-auto'>
                {{ content.field_service_catalog }}
            </div>
        </div>
    </div>
    {% endif %}
</article>
