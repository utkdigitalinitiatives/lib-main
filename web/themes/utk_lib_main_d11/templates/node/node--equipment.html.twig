{#
/**
 * @file
 * Full Equipment page.
 */
#}

{% set image_style = 'large' %}
{% set image_urls = [] %}
{% set alt_texts = [] %}

{% if node.field_equipment_featured_image.entity %}
  {% set media = node.field_equipment_featured_image.entity %}
  {% if media.field_media_image.entity %}
    {% set image_urls = image_urls|merge([media.field_media_image.entity.uri.value|image_style(image_style)]) %}
    {% set alt_texts = alt_texts|merge([media.field_media_image.alt|default('')]) %}
  {% endif %}
{% endif %}

{% for item in node.field_additional_equipment_image %}
  {% set media = item.entity %}
  {% if media and media.field_media_image.entity %}
    {% set image_urls = image_urls|merge([media.field_media_image.entity.uri.value|image_style(image_style)]) %}
    {% set alt_texts = alt_texts|merge([media.field_media_image.alt|default('')]) %}
  {% endif %}
{% endfor %}

<article{{ attributes.addClass(['node', 'node--type-equipment', 'text-smokey', 'link-link']) }}>
  {{ include('@utk_lib_main_d11/templates/views/utk--page-hero.html.twig', {
    title: node.label,
    image_src: hero_image_src|default(''),
    image_alt: hero_image_alt|default(''),
  }) }}

  <div class="container-fluid utk--striped-background py-4">
    <div class="row g-4 utk--1400px-width mx-auto align-items-start">
      {% if image_urls|length %}
        <div class="col-12 col-lg-6 pt-2">
          {% if image_urls|length > 1 %}
            {% set carousel_id = 'equipment-page-carousel-' ~ node.id %}
            <div id="{{ carousel_id }}" class="carousel slide utk-carousel rounded overflow-hidden">
              <div class="carousel-indicators">
                {% for image_url in image_urls %}
                  <button type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide-to="{{ loop.index0 }}"{% if loop.first %} class="active" aria-current="true"{% endif %} aria-label="Show image {{ loop.index }}"></button>
                {% endfor %}
              </div>
              <div class="carousel-inner">
                {% for image_url in image_urls %}
                  <div class="carousel-item{% if loop.first %} active{% endif %}">
                    <div class="image-wrapper">
                      <img src="{{ image_url }}" class="d-block w-100" alt="{{ alt_texts[loop.index0] }}" loading="lazy">
                    </div>
                  </div>
                {% endfor %}
              </div>
              <button class="carousel-control-prev" type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous image</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next image</span>
              </button>
            </div>
          {% else %}
            <div class="image-wrapper rounded overflow-hidden shadow-sm">
              <img src="{{ image_urls[0] }}" class="d-block w-100" alt="{{ alt_texts[0] }}" loading="lazy">
            </div>
          {% endif %}
        </div>
      {% endif %}

      <div class="col-12 pt-2 {% if image_urls|length %}col-lg-6{% endif %}">
        {% set equipment_details_content %}
            <div class="row g-4">
              {% if not node.field_equipment_brand.isEmpty %}
                {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
                  label: 'Brand',
                  value: content.field_equipment_brand,
                }, with_context: false) }}
              {% endif %}
              {% if not node.field_equipment_type.isEmpty %}
                {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
                  label: 'Type',
                  value: content.field_equipment_type,
                }, with_context: false) }}
              {% endif %}
              {% if not node.field_equipment_location.isEmpty %}
                {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
                  label: 'Location',
                  value: content.field_equipment_location,
                }, with_context: false) }}
              {% endif %}
              {% if not node.field_loan_period.isEmpty %}
                {{ include('@utk_lib_main_d11/templates/components/utk--detail-item.html.twig', {
                  label: 'Loan Period',
                  value: content.field_loan_period,
                }, with_context: false) }}
              {% endif %}
            </div>

            {% if not node.field_primo_link.isEmpty %}
              <div class="mt-4">
                <a class="btn utk-blue-button" href="{{ node.field_primo_link.0.url }}">Check Availability</a>
              </div>
            {% endif %}
        {% endset %}
        {{ include('@utk_lib_main_d11/templates/components/utk--panel-card.html.twig', {
          title: 'Details',
          card_content: equipment_details_content,
          variant: 'details',
          card_classes: ['mb-4'],
        }, with_context: false) }}

        {% if not node.field_equipment_description.isEmpty %}
          <div class="utk-search-selector link-link underline-active">
            <h2 class="fs-3 utk-section-heading">Description/Specifications</h2>
            {{ content.field_equipment_description }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</article>
