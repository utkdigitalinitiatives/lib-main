{#
/**
 * @file
 * UTK Custom - Action Card template.
 *
 * This template is used to render an action card component with custom styling and layout.
 *
 * Available variables:
 * - description: The description text displayed in the card.
 * - url: The URL for the action link.
 * - link_title: The text for the action link.
 *
 * Customizations:
 * - Displays a card with a title, description, and a call-to-action link.
 * - Includes responsive design for proper alignment and spacing.
 * - Applies custom classes for consistent styling across the site.
 *
 * @see template_preprocess()
 */
#}

<div class='col-md-6 col-12 d-flex justify-content-center py-2 mx-auto'>
    <article class='utk-card-surface utk-action-card'>
        <div class='utk-action-card__body'>
            <div class='utk-action-card__summary fs-5 fw-medium'>
                {{ description }}
            </div>
            <div class='utk-action-card__actions'>
                <a href="{{ url }}" class='utk-blue-button py-1 px-2'>{{ link_title }}</a>
            </div>
        </div>
    </article>
</div>
