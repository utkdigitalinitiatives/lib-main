{#
/**
 * @file
 * UTK Custom - Card template.
 *
 * This template is used to render a card component with custom styling and layout.
 * Generally based off of the default bootstrap card styling
 *
 * Available variables:
 * - img_src: The URL of the optional card image.
 * - img_alt: Alternative text for the optional card image.
 * - card_title: The optional card heading.
 * - text_body: The card's optional body content.
 * - button_url: The URL for the optional action link.
 * - button_title: The text for the optional action link.
 *
 * Customizations:
 * - Displays a card with a title, description, and a call-to-action link.
 * - Includes responsive design for proper alignment and spacing.
 * - Applies custom classes for consistent styling across the site.
 *
 * @see template_preprocess()
 */
#}

{% set is_summary_only = not img_src and not card_title %}
{% set card_classes = [
    'utk-card-surface',
    'utk-card',
    is_summary_only ? 'utk-card--summary-only',
] %}

<article class="{{ card_classes|join(' ')|trim }}">
    {% if img_src %}
        <div class="utk-card__media">
            <img src="{{ img_src }}" alt="{{ img_alt }}" loading="lazy">
        </div>
    {% endif %}
    <div class="utk-card__body">
        {% if card_title %}
            <h4 class="utk-card__title text-link">{{ card_title }}</h4>
        {% endif %}
        {% if text_body %}
            <div class="utk-card__text text-smokey">
                {{ text_body }}
            </div>
        {% endif %}
        {% if button_url %}
            <div class="utk-card__actions">
                <a href="{{ button_url }}" class="utk-blue-button py-1 px-2">{{ button_title|default('Learn more', true) }}</a>
            </div>
        {% endif %}
    </div>
</article>
