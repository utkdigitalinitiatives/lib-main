{#
/**
 * @file
 * UTK Custom - Card template.
 *
 * This template is used to render a card component with custom styling and layout.
 * Generally based off of the default bootstrap card styling
 *
 * Available variables:
 * - description: The description text displayed in the card.
 * - url: The URL for the action link.
 * - link_title: The text for the action link.
 *
 * Customizations:
 * - Displays a card with a title, description, and a call-to-action link.
 * - Includes responsive design for proper alignment and spacing.
 * - Applies custom classes for consistent styling across the site.
 *
 * @see template_preprocess()
 */
#}

<article class="utk-card-surface utk-card">
    {% if img_src %}
    <div class="utk-card__media">
        <img src="{{ img_src }}" alt="{{ img_alt }}" loading="lazy">
    </div>
    {% endif %}
    <div class="utk-card__body">
        {% if card_title %}
        <h4 class="utk-card__title text-link">{{ card_title }}</h4>
        {% endif %}
        {% if text_body %}
        <div class="utk-card__text text-smokey">
            {{ text_body }}
        </div>
        {% endif %}
        {% if button_url %}
        <div class="utk-card__actions">
            <a href="{{ button_url }}" class="btn utk-blue-button">{{ button_title|default('Learn more', true) }}</a>
        </div>
        {% endif %}
    </div>
</article>
