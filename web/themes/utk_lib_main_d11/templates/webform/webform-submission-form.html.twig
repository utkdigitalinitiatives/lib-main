{% set webform_title = drupal_title() %}
{% if use_webform_page_hero %}
    {{ include('@utk_lib_main_d11/templates/views/utk--page-hero.html.twig', {
        title: webform_title,
    }) }}
{% else %}
    <div class='container-fluid py-2 webform-title'>
        <p class='d-flex justify-content-center py-3'>
            {{ webform_title }}
        </p>
    </div>
{% endif %}
<div class='container-fluid d-lg-flex justify-content-center utk-article text-smokey link-link utk--webform mx-2 px-2{% if use_webform_page_hero %} pt-4{% endif %}'>
    <div class='utk-section-body'>
        {{ form }}
    </div>
</div>
