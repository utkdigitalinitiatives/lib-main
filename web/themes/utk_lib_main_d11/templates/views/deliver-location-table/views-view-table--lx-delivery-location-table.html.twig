<div class='table-responsive'>
    <table class='table table-striped text-smokey'>
        <thead class='text-smokey'>
            <tr>
                <th scope='col' class='text-smokey'>{{ header.name.content }}</th>
                <th scope='col' class='text-smokey'>{{ header.field_delivery_location.content }}</th>
            </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            <tr class='text-smokey'>
                <td class='text-smokey'>{% autoescape false %}{{ row.columns.name.content[0].field_output["#markup"]|render|striptags|trim }}{% endautoescape %}</td>
                <td class='text-link'>{% autoescape false %}{{ row.columns.field_delivery_location.content[0].field_output["#markup"]|render|striptags|trim }}{% endautoescape %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
