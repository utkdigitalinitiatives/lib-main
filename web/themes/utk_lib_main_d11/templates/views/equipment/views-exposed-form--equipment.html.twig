{#
/**
 * @file
 * Exposed filters for the Equipment directory.
 */
#}

<div {{ attributes.addClass('w-100') }}>
  <form {{ form.attributes }}>
    <div class="row g-3 align-items-end justify-content-center">
      <div class="col-12 col-sm-6 col-lg-3">
        {{ form.field_equipment_type_target_id }}
      </div>
      <div class="col-12 col-sm-6 col-lg-3">
        {{ form.field_equipment_location_target_id }}
      </div>
      <div class="col-12 col-sm-6 col-lg-3">
        {{ form.field_equipment_brand_target_id }}
      </div>
      <div class="col-12 col-lg-auto text-center">
        {{ form.actions.submit|add_class(['btn', 'utk-smokey-button']) }}
        {% if form.actions.reset %}
          {{ form.actions.reset|add_class(['btn', 'utk-blue-button', 'ms-2', 'p-2']) }}
        {% endif %}
      </div>
    </div>
    {{ form.form_build_id }}
    {{ form.form_token }}
    {{ form.form_id }}
  </form>
</div>
