{#
/**
 * @file
 * UTK Custom - News Feed Page View Fields template.
 *
 * This template is used to render individual fields within the News Feed Page view
 * with custom styling and layout.
 *
 * Available variables:
 * - fields: An array of fields available in the view, including:
 *   - fields.title: The title of the news article.
 *   - fields.field_blurb: A short summary or blurb for the article.
 *   - fields.field_sections: The main content sections of the article.
 *   - fields.field_publishing_date: The publishing date of the article.
 * - row: The current row object being rendered, including the News node and its
 *   field_featured_news_image media reference.
 *
 * Customizations:
 * - Dynamically truncates the blurb or section text to 400 characters for a concise preview.
 * - Displays a featured image if available, with lazy loading for performance.
 * - Provides a structured layout with the article title, image, and summary.
 * - Ensures responsive design for both desktop and mobile layouts.
 *
 * @see views-view-fields.html.twig
 */
#}

{% set blurb = fields.field_blurb.content|render|striptags %}
{% set section_text = fields.field_sections.content|render|striptags %}
{% set publish_date = fields.field_publishing_date.content|render|striptags|trim %}
{% set image_src = '' %}
{% set image_alt = '' %}

{% if row._entity.field_featured_news_image.entity %}
  {% set media = row._entity.field_featured_news_image.entity %}
  {% if media.field_media_image.entity %}
    {% set image_src = media.field_media_image.entity.uri.value|image_style('large') %}
    {% set image_alt = media.field_media_image.alt|default(row._entity.label) %}
  {% endif %}
{% endif %}

{% set summary = blurb|trim ? blurb : section_text %}

<div class="row utk-section-body py-3 mb-4 border-bottom">
  <div class="row mx-0 mb-2 px-0 link-link">
    <div class="px-0"><h2 class="fs-4 mb-1">{{ fields.title.content }}</h2></div>
  </div>
  <div class="row mx-0 px-0">
    {% if image_src %}
      <div class="col-md-3 px-0 pe-md-3 mb-3 mb-md-0">
        <img class="img-fluid rounded shadow-sm" src="{{ image_src }}" alt="{{ image_alt }}" loading="lazy" />
      </div>
    {% endif %}
    <div class="col px-0">
      <p class="text-muted mb-2"><strong>{{ publish_date|date('F j, Y') }}</strong></p>
      <p class="mb-0">{{ summary|length > 400 ? summary|slice(0, 400) ~ '...' : summary }}</p>
    </div>
  </div>
  <div class="row mx-0 mt-2 px-0">
    <div class="px-0">
      <a href="{{ fields.view_node.content|render|striptags|trim }}" class="btn utk-blue-button p-2">Read More</a>
    </div>
  </div>
</div>
