 * - view: The view object being rendered.
 *
 * Customizations:
 * - Provides a structured layout with the portal item title.
 * - Ensures responsive design for both desktop and mobile layouts.
 *
 * @see views-view-fields.html.twig
 */
#}

<div class='text-smokey link-link utk-search-selector d-flex align-items-start py-lg-1 py-2 mx-2 utk-portal-card__item-row'>
    <div class='ps-2'>
        {{ fields.title.content }}
    </div>
</div>
