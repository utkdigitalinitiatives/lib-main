{#
/**
 * @file
 * UTK Custom - Events Block View Fields template.
 *
 * This template is used to render individual fields within the Events Block view
 * with custom styling and layout.
 *
 * Available variables:
 * - fields: An array of fields available in the view, including:
 *   - fields.field_event_start: The start date and time of the event.
 *   - fields.field_event_location_name: The location name of the event.
 *   - fields.title: The title of the event.
 *   - fields.field_event_url: The URL linking to the full event details.
 * - view: The view object being rendered.
 *
 * Customizations:
 * - Dynamically sets the month and day for the event date.
 * - Maps specific location names to shorter, user-friendly titles.
 * - Provides a structured layout with the event date, title, time, and location.
 * - Includes SVG icons for time and location for better visual representation.
 * - Ensures responsive design for both desktop and mobile layouts.
 *
 * @see views-view-fields.html.twig
 */
#}

{% set month = fields.field_event_start.content|striptags|date('M')  %}
{% set day = fields.field_event_start.content|striptags|date('j') %}

{% if fields.field_event_location_name.content|render|striptags|trim == 'John C Hodges Library'  %}
    {% set library_title_short = 'Hodges Library' %}
{% elseif fields.field_event_location_name.content|render|striptags|trim == 'Pendergrass Agriculture &amp; Veterinary Medicine Library' %}
    {% set library_title_short = 'Pendergrass Library' %}
{% elseif fields.field_event_location_name.content|render|striptags|trim == 'Betsey B. Creekmore Special Collections and University Archives' %}
    {% set library_title_short = 'Hodges Library' %}
{% elseif fields.field_event_location_name.content|render|striptags|trim == 'Virtual Event' %}
    {% set library_title_short = 'Virtual Event' %}
{% endif %}

<div class='container-fluid d-flex justify-content-center py-2 utk--events'>
    <div class='col-2 px-0 utk--events-date'>
        <div class='utk--events-month text-center'>
            {{ month }}
        </div>
        <div class='row d-flex justify-content-center text-center utk--events-day'>
            {{ day }}
        </div>
    </div>
    <div class='col-10 utk--events-info px-3 '>
        <div class='row d-flex justify-content-start text-start text-wrap text-smokey link-link utk-search-selector'>
            <div>
                <a href="{{ fields.field_event_url.content|render|striptags|trim }}" class='utk--events-title'> 
                    {{ fields.title.content }}
                </a>
            </div>
        </div>
        <div class='row d-flex justify-content-start align-items-center utk--events-info-date'>
            <svg class='col-1 px-0' width="20" height="20" fill="none" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label='clock-icon'>
                <path d="M12 2c5.523 0 10 4.478 10 10s-4.477 10-10 10S2 17.522 2 12 6.477 2 12 2Zm0 1.667c-4.595 0-8.333 3.738-8.333 8.333 0 4.595 3.738 8.333 8.333 8.333 4.595 0 8.333-3.738 8.333-8.333 0-4.595-3.738-8.333-8.333-8.333ZM11.25 6a.75.75 0 0 1 .743.648L12 6.75V12h3.25a.75.75 0 0 1 .102 1.493l-.102.007h-4a.75.75 0 0 1-.743-.648l-.007-.102v-6a.75.75 0 0 1 .75-.75Z" fill="#4b4b4b"/>
            </svg>
            <div class='col px-0'>
                {{ fields.field_event_start.content|striptags|date('g:i A') }}
            </div>
            {% if library_title_short|length > 0 %}
                <svg class='col-1 px-0' width="20" height="20" fill="none" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label='location-icon'>
                    <path d="M5.843 4.568a8.707 8.707 0 1 1 12.314 12.314l-1.187 1.174c-.875.858-2.01 1.962-3.406 3.312a2.25 2.25 0 0 1-3.128 0l-3.491-3.396c-.439-.431-.806-.794-1.102-1.09a8.707 8.707 0 0 1 0-12.314Zm11.253 1.06A7.207 7.207 0 1 0 6.904 15.822L8.39 17.29a753.98 753.98 0 0 0 3.088 3 .75.75 0 0 0 1.043 0l3.394-3.3c.47-.461.863-.85 1.18-1.168a7.207 7.207 0 0 0 0-10.192ZM12 7.999a3.002 3.002 0 1 1 0 6.004 3.002 3.002 0 0 1 0-6.003Zm0 1.5a1.501 1.501 0 1 0 0 3.004 1.501 1.501 0 0 0 0-3.003Z" fill="#212121"/>
                </svg>
                <div class="col px-0">
                    {{ library_title_short }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
