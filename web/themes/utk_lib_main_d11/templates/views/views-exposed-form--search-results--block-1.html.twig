{#
/**
 * @file
 * UTK Custom - Search Results Block Exposed Form template.
 *
 * This template customizes the exposed filters form for the search results view.
 *
 * Available variables:
 * - form: The complete form array.
 * - attributes: Attributes for the outer form element.
 */
#}

<div {{ attributes.addClass('utk-search-filter-container p-0') }}>
  <form {{ form.attributes.addClass('row g-0').setAttribute('aria-label', 'Search library resources').setAttribute('id', 'site-search-form').setAttribute('action', '/search-results') }}>
    {# Search field with button in an input group #}
      <div class="col input-group">
        {% if form.search_api_fulltext %}
          {% if form.search_api_fulltext['#title'] %}
            <label class="visually-hidden" for="{{ form.search_api_fulltext['#id'] }}">
              {{ form.search_api_fulltext['#title'] }}
            </label>
          {% endif %}
          
          {% set attributes = form.search_api_fulltext['#attributes']|default({}) %}
          {% set attributes = attributes|merge({
            'class': attributes.class|default([])|merge(['form-control']),
            'placeholder': 'Search our website...',
            'id': 'site-search-input'
          }) %}
          
          {% set form = form|merge({
            'search_api_fulltext': form.search_api_fulltext|merge({
              '#attributes': attributes
            })
          }) %}
          
          {{ form.search_api_fulltext }}
        {% endif %}
        
        {# Submit button #}
        {% if form.actions.submit %}
          {% set submit_attributes = form.actions.submit['#attributes']|default({}) %}
          {% set submit_attributes = submit_attributes|merge({
            'class': submit_attributes.class|default([])|merge(['btn', 'utk-blue-button', 'px-md-3']),
            'id': 'button-site-search'
          }) %}
          
          {% set form = form|merge({
            'actions': form.actions|merge({
              'submit': form.actions.submit|merge({
                '#attributes': submit_attributes
              })
            })
          }) %}
          
          {{ form.actions.submit }}
        {% endif %}
      </div>
    
    {# Required hidden fields #}
    {{ form.form_build_id }}
    {{ form.form_token }}
    {{ form.form_id }}
    
    {# Any additional filters #}
    {% for key, filter in form %}
      {% if key|first != '#' and key != 'actions' and key != 'search_api_fulltext' and key != 'form_build_id' and key != 'form_token' and key != 'form_id' %}
        <div class="col-md-4 p-0">
          {{ filter }}
        </div>
      {% endif %}
    {% endfor %}
  </form>
</div>
