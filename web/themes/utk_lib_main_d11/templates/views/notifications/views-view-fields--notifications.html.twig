{#
/**
 * @file
 * Renders one site-wide notification.
 *
 * Available fields:
 * - fields.title: Notification title.
 * - fields.field_notification_text: Short notification message.
 * - fields.field_notification_severity: Critical, Standard, or Warning.
 * - row._entity: The Notification node for checking additional detail content.
 *
 * @see views-view-fields.html.twig
 */
#}

{% set severity = fields.field_notification_severity.content|render|striptags|trim|clean_class %}
{% set has_details = not row._entity.field_notification_page_addition.isEmpty %}

<div class="notification-wrapper notification-{{ severity }} my-0 py-0" role="status">
  <div class="text-center pt-2 pb-1 fw-bolder fs-5">
    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M9.042 19.003h5.916a3 3 0 0 1-5.916 0Zm2.958-17a7.5 7.5 0 0 1 7.5 7.5v4l1.418 3.16A.95.95 0 0 1 20.052 18h-16.1a.95.95 0 0 1-.867-1.338l1.415-3.16V9.49l.005-.25A7.5 7.5 0 0 1 12 2.004ZM23 8.25a.75.75 0 0 1 .102 1.493L23 9.75h-2a.75.75 0 0 1-.102-1.493L21 8.25h2Zm-20 0a.75.75 0 0 1 .102 1.493L3 9.75H1a.75.75 0 0 1-.102-1.493L1 8.25h2Zm19.6-5.7a.75.75 0 0 1-.066.977l-.084.073-2 1.5a.75.75 0 0 1-.984-1.127l.084-.073 2-1.5a.75.75 0 0 1 1.05.15ZM2.45 2.4l2 1.5a.75.75 0 1 1-.9 1.2l-2-1.5a.75.75 0 1 1 .9-1.2Z" />
    </svg>
    {% if has_details %}
      <a href="{{ path('entity.node.canonical', {'node': row._entity.id}) }}">{{ fields.title.content }}</a>
    {% else %}
      {{ fields.title.content }}
    {% endif %}
  </div>
  <div class="d-lg-flex justify-content-center my-0 py-1">
    <div class="px-2 notification-text">
      {{ fields.field_notification_text.content }}
    </div>
  </div>
</div>
