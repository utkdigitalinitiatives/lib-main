{#
/**
 * @file
 * Renders one site-wide notification.
 *
 * Available fields:
 * - fields.title: Notification title.
 * - fields.field_notification_text: Short notification message.
 * - fields.field_notification_severity: Critical, Standard, or Warning.
 * - row._entity: The Notification node for checking additional detail content.
 *
 * @see views-view-fields.html.twig
 */
#}

{% set severity = fields.field_notification_severity.content|render|striptags|trim|clean_class %}
{% set has_details = not row._entity.field_notification_page_addition.isEmpty %}

<div class="notification-wrapper notification-{{ severity }} alert alert-dismissible fade show" role="{{ severity == 'critical' ? 'alert' : 'status' }}">
  <div class="notification-content">
    {% if has_details %}
      <a class="notification-title" href="{{ path('entity.node.canonical', {'node': row._entity.id}) }}">{{ fields.title.content }}</a>
    {% else %}
      <span class="notification-title">{{ fields.title.content }}</span>
    {% endif %}
    <div class="notification-text">
      {{ fields.field_notification_text.content }}
    </div>
  </div>
  <button type="button" class="notification-close btn-close" data-bs-dismiss="alert" aria-label="Dismiss notification"></button>
</div>
