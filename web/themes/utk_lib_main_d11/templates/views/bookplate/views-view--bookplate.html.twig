{#
/**
 * Custom presentation for the Bookplate View.
 *
 * The View, filters, sorting, and pager remain configured in Drupal. This
 * template only supplies the page layout and responsive results grid.
 */
#}

{% set title = view.title %}

{{ include('@utk_lib_main_d11/templates/views/utk--page-hero.html.twig', {
  title: title,
}) }}

<div class="utk-page-hero-panel utk-page-hero-panel--curved">
  <section class="container-fluid utk-page-hero-panel__section">
    <div class="utk-page-hero-panel__content">
      {{ exposed }}
    </div>
  </section>
</div>

<section class="container-fluid my-4 py-3">
  <div class="bookplate-card-grid max-row-width mx-auto px-2">
    {% if rows %}
      {{ rows }}
    {% endif %}
  </div>
</section>

{% if pager %}
  <div class="pb-2 mb-2 utk-search-selector">
    {{ pager }}
  </div>
{% endif %}
