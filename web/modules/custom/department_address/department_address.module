<?php

/**
 * @file
 * Department Address module file.
 *
 * Provides conditional visibility for the Department address field group.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_node_form_alter().
 *
 * Shows/hides the address fields on the Department node form
 * based on the "Add Address" boolean field state.
 */
function department_address_form_node_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $node = $form_state->getFormObject()->getEntity();

  // Only apply this logic to Department node forms.
  if ($node->bundle() !== 'department') {
    return;
  }

  // Define the address fields that should be conditionally visible.
  $address_fields = [
    'field_address_street',
    'field_address_city',
    'field_address_state',
    'field_address_zip',
  ];

  // Define the states condition for when to show the address section.
  $visibility_condition = [
    ':input[name="field_add_address[value]"]' => ['checked' => TRUE],
  ];

  // Apply #states to the field group wrapper itself if it exists.
  if (isset($form['group_address'])) {
    $form['group_address']['#states'] = [
      'visible' => [$visibility_condition],
    ];
  }

  // Also apply #states to individual address fields as a fallback.
  // This ensures that when the checkbox is unchecked, all address fields are hidden,
  // which will effectively hide the fieldset (either by Field Group or by CSS).
  foreach ($address_fields as $field_name) {
    if (isset($form[$field_name])) {
      $form[$field_name]['#states'] = [
        'visible' => [$visibility_condition],
      ];
    }
  }

  // Attach custom behavior to handle the fieldset visibility more elegantly.
  // This ensures the fieldset wrapper is hidden when all children are hidden.
  $form['#attached']['library'][] = 'department_address/conditional_visibility';
}
