{#
/**
 * @file
 * Default theme implementation for the labeled email formatter.
 *
 * Variables:
 * - label: The label text (e.g., "Main", "Support", "Admissions")
 * - show_label: Boolean. FALSE when there is exactly one item and the label is
 *   "Main" (the default single-contact case). TRUE in all other cases.
 * - email: The email address (e.g., "info@example.edu")
 */
#}

<div class="labeled-email-item">
  {% if show_label %}
    <span class="labeled-email-label">{{ label }}</span>
  {% endif %}
  <a href="mailto:{{ email }}" class="labeled-email-link">{{ email }}</a>
</div>
