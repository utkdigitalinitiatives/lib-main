{#
/**
 * @file
 * Default theme implementation for labeled phone formatter.
 *
 * Variables:
 * - label: The label text (e.g., "Main", "Sales")
 * - phone_display: The phone number formatted for display (e.g., "555-555-1234")
 * - phone_tel: The phone number as digits-only for tel: link (e.g., "5555551234")
 */
#}

<div class="labeled-phone-item">
  {% if label %}
    <span class="labeled-phone-label">{{ label }}</span>
  {% endif %}
  <a href="tel:{{ phone_tel }}" class="labeled-phone-link">{{ phone_display }}</a>
</div>
