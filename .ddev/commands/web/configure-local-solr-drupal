#!/usr/bin/env bash
set -euo pipefail

## Description: Point all local Search API Solr servers to the DDEV Solr container.
## Usage: configure-local-solr-drupal
## Example: ddev configure-local-solr-drupal

if [[ "${IS_DDEV_PROJECT:-}" != "true" ]]; then
  echo "Not a DDEV environment. Skipping local Solr configuration."
  exit 0
fi

if ! command -v drush >/dev/null 2>&1; then
  echo "Drush is not available in the web container. Skipping local Solr configuration."
  exit 0
fi

# Avoid failing startup when Drupal is not installed yet.
if ! drush status --fields=bootstrap --format=list 2>/dev/null | grep -q "Successful"; then
  echo "Drupal bootstrap not available yet. Skipping local Solr configuration."
  exit 0
fi

drush php:eval '
$host = getenv("DRUPAL_SOLR_LOCAL_HOST") ?: "solr";
$port = (int) (getenv("DRUPAL_SOLR_LOCAL_PORT") ?: 8983);
$path = getenv("DRUPAL_SOLR_LOCAL_PATH") ?: "/solr";
$scheme = getenv("DRUPAL_SOLR_LOCAL_SCHEME") ?: "http";
$username = getenv("DRUPAL_SOLR_LOCAL_USERNAME") ?: "";
$password = getenv("DRUPAL_SOLR_LOCAL_PASSWORD") ?: "";
$coreOverride = getenv("DRUPAL_SOLR_LOCAL_CORE") ?: "";

$storage = \Drupal::service("config.storage");
$configFactory = \Drupal::service("config.factory");
$updated = [];

foreach ($storage->listAll("search_api.server.") as $configName) {
  $editable = $configFactory->getEditable($configName);
  if ($editable->get("backend") !== "search_api_solr") {
    continue;
  }

  $editable->set("backend_config.connector_config.scheme", $scheme);
  $editable->set("backend_config.connector_config.host", $host);
  $editable->set("backend_config.connector_config.port", $port);
  $editable->set("backend_config.connector_config.path", $path);

  if ($coreOverride !== "") {
    $editable->set("backend_config.connector_config.core", $coreOverride);
  }

  if ($username !== "") {
    $editable->set("backend_config.connector_config.username", $username);
  }
  else {
    $editable->clear("backend_config.connector_config.username");
  }

  if ($password !== "") {
    $editable->set("backend_config.connector_config.password", $password);
  }
  else {
    $editable->clear("backend_config.connector_config.password");
  }

  $editable->save(TRUE);
  $updated[] = $configName;
}

if (!$updated) {
  echo "No Search API Solr servers found to update.";
}
else {
  echo "Updated local Solr connector settings for: " . implode(", ", $updated);
}
'